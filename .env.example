# Copy to .env.local for local development. On Railway, set these as service variables.

# Postgres connection. On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/randomnoise

# Public address used in email links. On Railway this falls back to the Railway domain.
APP_URL=http://localhost:3000

# The one admin (also a player). Their account is created on first login.
ADMIN_EMAIL=topher.d@me.com
ADMIN_NAME=Topher

# Resend. Leave RESEND_API_KEY empty locally: emails (with their links) print to the console instead.
RESEND_API_KEY=
EMAIL_FROM="Random Noise <game@randomnoise.ai>"
